{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://courier.couriermig.ru",
        "EXPO_PUBLIC_OAUTH_PORTAL_URL": "https://courier.couriermig.ru",
        "EXPO_PUBLIC_OAUTH_SERVER_URL": "https://courier.couriermig.ru",
        "EXPO_PUBLIC_APP_ID": "courier-app",
        "EXPO_PUBLIC_OWNER_OPEN_ID": "owner-id",
        "EXPO_PUBLIC_OWNER_NAME": "Courier Service"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://courier.couriermig.ru",
        "EXPO_PUBLIC_OAUTH_PORTAL_URL": "https://courier.couriermig.ru",
        "EXPO_PUBLIC_OAUTH_SERVER_URL": "https://courier.couriermig.ru",
        "EXPO_PUBLIC_APP_ID": "courier-app",
        "EXPO_PUBLIC_OWNER_OPEN_ID": "owner-id",
        "EXPO_PUBLIC_OWNER_NAME": "Courier Service"
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://courier.couriermig.ru",
        "EXPO_PUBLIC_OAUTH_PORTAL_URL": "https://courier.couriermig.ru",
        "EXPO_PUBLIC_OAUTH_SERVER_URL": "https://courier.couriermig.ru",
        "EXPO_PUBLIC_APP_ID": "courier-app",
        "EXPO_PUBLIC_OWNER_OPEN_ID": "owner-id",
        "EXPO_PUBLIC_OWNER_NAME": "Courier Service"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

{
  "name": "app-template",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:metro\"",
    "dev:server": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "dev:metro": "cross-env EXPO_USE_METRO_WORKSPACE_ROOT=1 npx expo start --web --port ${EXPO_PORT:-8081}",
    "build": "pnpm run build:frontend && pnpm run build:backend",
    "build:frontend": "cd courier-manager && pnpm run build",
    "build:backend": "esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "smoke:realtime": "node scripts/smoke-realtime.mjs",
    "smoke:manifest": "node scripts/smoke-manifest-import.mjs",
    "smoke:courier": "node scripts/smoke-courier-status.mjs",
    "smoke:manager": "node scripts/smoke-manager-realtime.mjs",
    "smoke:manager:data": "node scripts/smoke-manager-data-integrity.mjs",
    "smoke:auth": "node scripts/smoke-auth-session.mjs",
    "smoke:startup": "node scripts/smoke-production-startup.mjs",
    "smoke:build": "node scripts/smoke-production-build.mjs",
    "smoke:docker": "node scripts/smoke-docker-runtime.mjs",
    "smoke:trpc": "node scripts/smoke-trpc-routes.mjs",
    "smoke:local": "pnpm smoke:build && pnpm smoke:startup && pnpm smoke:docker",
    "smoke:live": "pnpm smoke:trpc && pnpm smoke:auth && pnpm smoke:realtime && pnpm smoke:manager && pnpm smoke:manager:data && pnpm smoke:manifest",
    "smoke:all": "pnpm smoke:local && pnpm smoke:live",
    "verify:production": "node scripts/verify-production.mjs",
    "predeploy:local": "node scripts/predeploy-local.mjs",
    "postdeploy:live": "node scripts/postdeploy-live.mjs",
    "db:migrate": "NODE_ENV=production drizzle-kit migrate",
    "check": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "qr": "node scripts/generate_qr.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@expo/ngrok": "^4.1.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.8.12",
    "@react-navigation/elements": "^2.9.2",
    "@react-navigation/native": "^7.1.25",
    "@tanstack/react-query": "^5.51.23",
    "@trpc/client": "11.7.2",
    "@trpc/react-query": "11.7.2",
    "@trpc/server": "11.7.2",
    "@types/bcryptjs": "^3.0.0",
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.35.1",
    "expo": "~54.0.29",
    "expo-audio": "~1.1.0",
    "expo-background-fetch": "^55.0.15",
    "expo-brightness": "^55.0.13",
    "expo-build-properties": "^1.0.10",
    "expo-clipboard": "^55.0.13",
    "expo-constants": "~18.0.12",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-location": "^55.1.8",
    "expo-notifications": "~0.32.15",
    "expo-router": "~6.0.19",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "^55.0.15",
    "expo-video": "~3.0.15",
    "expo-web-browser": "~15.0.10",
    "express": "^4.19.2",
    "jose": "6.1.0",
    "postgres": "^3.4.4",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-toast-notifications": "^3.4.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.5.1",
    "superjson": "^1.13.3",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.25",
    "@types/node": "^20.14.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.1.17",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.24.2",
    "esbuild": "^0.23.1",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.7.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.17.0",
    "typescript": "~5.9.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "mysql2": "null"
    }
  }
}

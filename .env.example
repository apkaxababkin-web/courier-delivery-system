# Backend Environment Variables

# Node environment
NODE_ENV=production

# Database
# Format: postgresql://user:password@host:port/database
# Для Yandex Managed Service for PostgreSQL:
# postgresql://courier:PASSWORD@c-xxxxx.postgres.yandexcloud.net:6432/courier_db?sslmode=require
DATABASE_URL=postgresql://courier:courier_password@localhost:5432/courier_db

# API Server
API_PORT=3000
API_HOST=0.0.0.0

# Frontend URLs (для CORS)
FRONTEND_URL=https://courier.site.ru
MANAGER_URL=https://site.ru

# Logging
LOG_LEVEL=info

# Session/Auth
SESSION_SECRET=your-secret-key-change-in-production

# Optional: External services
# SENTRY_DSN=https://...
# SLACK_WEBHOOK=https://...

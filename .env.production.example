# Production environment example for docker compose rollout
# Copy to .env on the production server and replace all change-me values.

NODE_ENV=production

# API
PORT=3000
FRONTEND_URL=https://couriermig.ru
LOG_LEVEL=info

# PostgreSQL
POSTGRES_USER=courier
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_DB=courier_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://courier:change-me-strong-postgres-password@postgres:5432/courier_db

# Auth/session secrets
SESSION_SECRET=change-me-long-random-session-secret
JWT_SECRET=change-me-long-random-jwt-secret

# Smoke / verification
PROD_URL=https://couriermig.ru
SMOKE_BASE_URL=https://couriermig.ru

# Deploy script overrides
APP_DIR=/home/ubuntu/courier-delivery-system
BRANCH=main
COMPOSE=docker compose

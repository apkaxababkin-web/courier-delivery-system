# Copy to .env.test for the isolated billing tests.
#
# DATABASE_URL points at a PostgreSQL SERVER. The tests create their own
# throwaway database (courier_billing_test_<pid>) on it, apply
# tests/fixtures/billing-schema.sql plus migration 0015, and drop the database
# again when they finish. The database named here is only used to open the
# connection, so no test data ever reaches it.
DATABASE_URL=postgresql://courier:courier_password@localhost:5432/courier_db

# The harness refuses to run against a non-local host because it creates and drops
# databases. Set TEST_ALLOW_REMOTE_DATABASE=1 only for a dedicated test server.
# TEST_ALLOW_REMOTE_DATABASE=1
